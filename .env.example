# Doctors At Door (DAD) - Environment Configuration
# Copy this file to .env.local and fill in your values. Set the same values on the production server.

# Public site address. Forms reject requests from any other host, so it must match the live domain.
NEXT_PUBLIC_SITE_URL=https://www.doctorsatdoor.com

# Supabase (public anon key; row-level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only Postgres connection used by the contact and account-deletion forms
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Optional but recommended: Supabase CA certificate (with \n for newlines), so the server identity is verified
# DATABASE_CA_CERT=

# Cloudflare Turnstile bot protection (never give the secret a NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key
# Optional extra hostnames allowed to submit forms, comma separated (for example a staging domain or localhost)
# TURNSTILE_ALLOWED_HOSTNAMES=localhost

# Brevo newsletter
BREVO_API_KEY=your-brevo-key
BREVO_LIST_ID=1
